{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"configurations"
	],
	"additionalProperties": false,
	"properties": {
		"configurations": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"type"
				],
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"type": {
						"enum": [
							"ruby",
							"rails",
							"rake",
							"rspec"
						]
					},
					"script": {
						"type": "string"
					},
					"args": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"cwd": {
						"type": "string"
					},
					"env": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						}
					},
					"bundle": {
						"type": "boolean",
						"default": false
					}
				}
			}
		},
		"version": {
			"type": "integer",
			"enum": [
				1
			]
		}
	}
}
